# ============================================================
# FUELWISE — Environment template.
#   cp .env.example .env
# ============================================================

# --------------- PHASE 1: Frontend (no API keys required!) ----------
VITE_MAP_CENTER_LAT=18.5204
VITE_MAP_CENTER_LNG=73.8567
VITE_DEFAULT_ZOOM=13
VITE_API_URL=http://localhost:8000

# --------------- PHASE 2 & 3: Backend & Database --------------------
DATABASE_URL=postgresql://fuelwise:fuelwise_pass@localhost:5432/fuelwise_db
TIMESCALE_URL=postgresql://fuelwise:fuelwise_pass@localhost:5432/fuelwise_tsdb
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --------------- PHASE 4: AI/ML Model Paths -------------------------
MODEL_PATH=./models/xgboost_model.pkl
SYNTHETIC_DATA_PATH=./data/synthetic_queue_data.csv

# --------------- PHASE 5: Voice & External APIs ---------------------
VITE_VOICE_API_KEY=YOUR_SPEECH_TO_TEXT_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
